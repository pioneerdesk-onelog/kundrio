# Öffentliche Demo (demo.kundrio.de): eigene Datenbank auf der VM, jede Nacht neu aufgebaut. Geheimnisse: Pfad „demo“.
NODE_ENV=production
APP_URL=https://demo.kundrio.de
PAYMENTS_PUBLIC_URL=https://demo.kundrio.de
APP_HOSTS=demo.kundrio.de
TRUST_PROXY=1
RATE_LIMIT_STORE=db
LOG_LEVEL=info
MAIL_MODE=capture
MESSAGING_MODE=capture
PAYMENTS_MODE=test
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
OLLAMA_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
OLLAMA_CHAT_MODEL=Qwen/Qwen3.6-27B
EMBED_DIM=1024
FILE_STORAGE_DIR=/data/files
DEMO_GUEST=guest:guest@demo.kundrio.de
RESEARCH_GDELT=off
# Testdaten-Seed (scripts/seed-e2e.ts) verlangt zwei Empfänger – in der Demo nur Platzhalter, Mails gehen nirgends hin
E2E_INTERNAL_EMAIL=team@demo.example.com
E2E_CUSTOMER_EMAIL=kunde@demo.example.com
