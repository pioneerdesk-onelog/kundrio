# Nicht geheime Einstellungen der Produktion (app.kundrio.de). Geheimnisse: STACKIT Secrets Manager, Pfad „app“.
NODE_ENV=production
APP_URL=https://app.kundrio.de
PAYMENTS_PUBLIC_URL=https://app.kundrio.de
APP_HOSTS=app.kundrio.de,kundrio.de,www.kundrio.de,demo.kundrio.de
TRUST_PROXY=1
RATE_LIMIT_STORE=db
LOG_LEVEL=info
MAIL_MODE=capture
MESSAGING_MODE=capture
PAYMENTS_MODE=test
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
OLLAMA_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
OLLAMA_CHAT_MODEL=Qwen/Qwen3.6-27B
EMBED_DIM=1024
S3_ENDPOINT=https://object.storage.eu01.onstackit.cloud
S3_BUCKET=kundrio-files
S3_REGION=eu01
LANDING_CNAME_TARGET=sites.kundrio.de
LANDING_IPV4=188.34.74.65
RESEARCH_GDELT=off
