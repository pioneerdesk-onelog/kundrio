# Lokale Entwicklung. Kopieren nach .env (wird nicht committet).
DATABASE_URL="postgresql://crm:crm_local_only@127.0.0.1:55433/crm?schema=public"

# Ollama (lokal)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBED_MODEL="qwen3-embedding:0.6b"
EMBED_DIM=1024
OLLAMA_CHAT_MODEL="qwen3.6:35b-a3b"
# Betrieb ohne lokales Ollama: OpenAI-kompatibler Dienst, z. B. STACKIT AI Model Serving (EU01).
# Modellnamen dann über OLLAMA_EMBED_MODEL / OLLAMA_CHAT_MODEL setzen; EMBED_DIM bleibt 1024.
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
# AI_API_KEY=        (Secret)

# E-Mail: lokal geht alles an Mailpit (http://127.0.0.1:58025)
SMTP_HOST="127.0.0.1"
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Echter Versand nur, wenn ausdrücklich auf "live" gestellt (Freigabe-Prinzip)
MAIL_MODE="capture"
# Nur bei MAIL_MODE="live": Freigabeliste für echten Versand (kommagetrennt, Adressen oder @domain).
# Gesetzt → nur diese Empfänger gehen über das Relay, alle anderen landen in Mailpit (Status "captured").
# Leer → in "live" geht ALLES echt raus (Produktion). Beispiel Abnahmetest:
# MAIL_LIVE_ALLOWLIST="ich@example.com,@example.org"
MAIL_LIVE_ALLOWLIST=""
# Relay-Beispiel Brevo: SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT=587 (STARTTLS wird erzwungen), SMTP_SECURE=false

# Geheimnis für signierte Abmeldelinks (beliebige lange Zufallszeichenkette)
APP_SECRET="bitte-ersetzen"
APP_URL="http://127.0.0.1:3100"

# YouTube Data API v3 (optional): nur öffentliche Kanalstatistiken. Leer = manuelle Eingabe.
YOUTUBE_API_KEY=""

# Eingang für Versand-Ereignisse des Relays (Bounces, Spam): /api/mail/events/brevo?secret=…
MAIL_EVENTS_SECRET=""
# Nur Entwicklung: Webhooks an private/lokale Ziele erlauben
WEBHOOK_ALLOW_PRIVATE=false

# Absender für System-Mails ohne Sub-Account-Bezug (z. B. Agentur-Einladungen), z. B. "Kundrio <crm@example.com>".
# Leer = Absender des ersten Sub-Accounts mit hinterlegter Adresse.
SYSTEM_MAIL_FROM=""

# Betrieb (Produktion siehe deploy/compose/.env.prod.example)
# Anzahl vertrauenswürdiger Reverse-Proxys (Caddy/Ingress = 1). Leer: Entwicklung 1, Produktion 0
TRUST_PROXY=
# Rate-Limits: memory (ein Prozess) oder db (mehrere Instanzen). Leer: Entwicklung memory, Produktion db
RATE_LIMIT_STORE=
LOG_LEVEL=info

# Lexware Office (Public API, Tarif XL). Schlüssel nur hier, nie in der Datenbank.
LEXWARE_API_KEY=""
# Optional für Tests gegen einen Mock-Server: LEXWARE_BASE_URL="http://127.0.0.1:4010"
LEXWARE_BASE_URL=""

# Anreicherung/Recherche: eigene SearXNG-Instanz (docker compose: Dienst "search", nur lokal erreichbar)
SEARXNG_URL="http://127.0.0.1:58080"
# Bevorzugte Suchdienste (EU-nahe zuerst); leer = SearXNG-Standard
SEARXNG_ENGINES="mojeek,startpage,duckduckgo"
# Nur Entwicklung/Tests: Anreicherung darf private Adressen (Mock-Server) abrufen
ENRICH_ALLOW_PRIVATE=false

# Social-Kanäle (nur lesend) – Redirect-URL je Plattform: <APP_URL>/api/channels/oauth/<plattform>/callback
# LinkedIn: App + Produkt „Community Management API“ (Freigabe durch LinkedIn nötig)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202609"
# Meta (Facebook-Seiten + Instagram Business): App vom Typ Business, Facebook Login for Business
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# X: App-only Bearer Token (kostenpflichtig, Pay-per-use) – Beiträge je Abruf begrenzen
X_BEARER_TOKEN=""
X_MAX_POSTS_PER_SYNC=10
# TikTok: Login Kit + Display API (App-Prüfung nötig)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Dateispeicher (Brandbook, Logos). Standard: lokaler Ordner app/.data/files.
# Für STACKIT Object Storage (S3-kompatibel) S3_ENDPOINT + S3_BUCKET setzen, dann wird S3 genutzt.
FILE_STORAGE_DIR=""
S3_ENDPOINT=""          # z. B. https://object.storage.eu01.onstackit.cloud
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="eu01"
# Nur Entwicklung/Tests: Website-CI-Abruf auch an lokale Adressen erlauben
BRAND_FETCH_ALLOW_PRIVATE=false

# ---------- Kalender & Video-Calls ----------
# Google (Meet): Google Cloud Console → Projekt → „Google Calendar API“ aktivieren → OAuth-Zustimmungsbildschirm
# (Google Workspace: Typ „Intern“) → Anmeldedaten → OAuth-Client-ID „Webanwendung“ →
# Weiterleitungs-URI: <APP_URL>/api/calendar/oauth/google/callback
# Bereiche: openid, email, calendar.events, calendar.freebusy, calendar.calendarlist.readonly
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft (Teams): Microsoft Entra Admin Center → App-Registrierungen → Neue Registrierung (Web,
# Umleitungs-URI <APP_URL>/api/calendar/oauth/microsoft/callback) → Zertifikate & Geheimnisse → Clientgeheimnis →
# API-Berechtigungen (delegiert): Calendars.ReadWrite, User.Read, offline_access, openid, email → ggf. Administratorzustimmung.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# Tenant-ID bzw. „organizations“ (nur Geschäftskonten – Teams-Besprechungen gibt es nur dort)
MS_TENANT="organizations"
# Video ohne Kalender-Verbindung (Einladung per .ics-Mail); souverän: eigener Jitsi/OpenTalk auf STACKIT
JITSI_BASE_URL="https://meet.jit.si"

# ---------- Eigene Kundendomains (Landingpages) ----------
# Ziel für CNAME-Einträge der Kunden (zeigt auf den öffentlichen Edge, z. B. Caddy)
LANDING_CNAME_TARGET="sites.pioneerdesk.cloud"
# Für Apex-Domains (kunde.de ohne Subdomain): feste Adressen des Edge, kommagetrennt
LANDING_IPV4=""
LANDING_IPV6=""
# Weitere Plattform-Hostnamen (kommagetrennt), die NICHT als Kundendomain gelten
APP_HOSTS=""
# Geheimnis für Caddy On-Demand-TLS (ask-Endpunkt /api/domains/ask)
CADDY_ASK_SECRET=""
# Mail-Domains: SPF-Include der Versandleitung, DKIM-Selektor/-Ziel, DMARC-Berichte (optional)
MAIL_SPF_INCLUDE=""
MAIL_DKIM_SELECTOR=""
MAIL_DKIM_TARGET=""
MAIL_DMARC_RUA=""
# Domain Connect: erst nach Freischaltung unseres Templates beim jeweiligen DNS-Anbieter setzen
DOMAIN_CONNECT_PROVIDER_ID=""
DOMAIN_CONNECT_SERVICE_ID=""
# Optional: eigene Prüf-Resolver (name=ip,…); leer = System, 1.1.1.1, 9.9.9.9, 8.8.8.8
DNS_CHECK_RESOLVERS=""

# --- STACKIT DNS (souveräne DNS-Verwaltung für Kunden-Domains, Plattform-Projekt von Pioneerdesk) ---
# Projekt-ID des STACKIT-Projekts, in dem die Kunden-Zonen liegen
STACKIT_DNS_PROJECT_ID=""
# Service-Account-Key (JSON aus dem STACKIT-Portal) als Datei – bevorzugt; alternativ Inhalt in STACKIT_SERVICE_ACCOUNT_KEY
STACKIT_SERVICE_ACCOUNT_KEY_PATH=""
STACKIT_SERVICE_ACCOUNT_KEY=""
# Nur falls der private Schlüssel nicht im Key-JSON steckt (eigenes Schlüsselpaar hochgeladen)
STACKIT_PRIVATE_KEY_PATH=""
# Nur Entwicklung: fest vorgegebenes Access-Token statt Key-Flow
STACKIT_DNS_TOKEN=""
# Kontaktadresse im SOA der angelegten Zonen
STACKIT_DNS_CONTACT_EMAIL=""

# --- WhatsApp & SMS (Posteingang) ---
# capture (Standard): nichts wird an Anbieter gesendet, nur protokolliert. live: echter Versand.
MESSAGING_MODE="capture"
# Optional: im Live-Modus nur an diese Nummern senden (kommagetrennt, E.164), Rest wird protokolliert
MESSAGING_LIVE_ALLOWLIST=""
# Basis-URLs (nur für Tests/Proxys ändern)
WHATSAPP_GRAPH_BASE="https://graph.facebook.com/v25.0"
SEVEN_API_BASE="https://gateway.seven.io"

# --- Zahlungen (Bezahllinks Mollie/Revolut/Unzer) & Kontoabgleich (Revolut Business, CAMT) ---
# test (Standard): nur Test-Zugänge der Anbieter erlaubt, Live-Schlüssel werden abgelehnt. live: echte Zahlungen möglich.
PAYMENTS_MODE="test"
# Öffentliche Basis-URL für Webhooks/Rückleitung (leer = APP_URL). Anbieter müssen sie aus dem Internet erreichen.
PAYMENTS_PUBLIC_URL=""
# Basis-URLs (nur für Tests/Proxys ändern; Test vs. Live wählt jeder Anbieter-Zugang selbst)
MOLLIE_API_BASE="https://api.mollie.com/v2"
REVOLUT_MERCHANT_BASE=""
REVOLUT_MERCHANT_API_VERSION="2026-08-17"
UNZER_API_BASE=""
REVOLUT_BUSINESS_BASE=""
