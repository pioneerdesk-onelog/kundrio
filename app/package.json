{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "rag:index": "tsx --env-file=.env scripts/devrag.ts index",
    "rag": "tsx --env-file=.env scripts/devrag.ts",
    "user:create": "tsx --env-file=.env scripts/user.ts",
    "worker": "tsx --conditions=react-server --env-file=.env scripts/worker.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "worker:prod": "node --conditions=react-server --import tsx scripts/worker.ts",
    "db:migrate:prod": "prisma migrate deploy",
    "e2e:seed": "tsx --env-file=.env scripts/seed-e2e.ts",
    "e2e:reset": "tsx --env-file=.env scripts/seed-e2e.ts --reset",
    "e2e": "tsx e2e/run.ts",
    "e2e:report": "tsx e2e/report.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@puckeditor/core": "^0.23.0",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3",
    "imapflow": "^2.2.7",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.52.0",
    "mailparser": "^3.9.36",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
