// Datenmodell von Kundrio.
// Grundregel: Jede fachliche Tabelle hängt an einem Workspace (= ein Online-Projekt).
// Abfragen IMMER mit workspaceId filtern (Mandantentrennung).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = Entwicklungsrechner; Container (Debian bookworm) und Alpine jeweils amd64 + arm64 (STACKIT arm64-Nodes)
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ---------- Agentur & Sub-Accounts ----------
// Agentur (z. B. Pioneerdesk GmbH) = oberste Ebene mit Gesamtübersicht.
// Workspace = Sub-Account (ein Online-Projekt oder später ein Kunde).

model Agency {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  workspaces Workspace[]
}

model Workspace {
  id            String  @id @default(cuid())
  agencyId      String
  agency        Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  slug          String  @unique
  name          String
  domain        String?
  description   String?
  // Absender für E-Mails dieses Projekts
  mailFromName  String?
  mailFromEmail String?

  // Branding je Sub-Account
  brandPrimary String  @default("#0B4F6C")
  brandAccent  String  @default("#C0D3DA")
  logoSvg      String? // SVG-Quelltext (wird beim Speichern bereinigt)
  fontHeading  String  @default("Newsreader")
  fontBody     String  @default("Inter")

  // Souveränität: Region, in der Daten dieses Sub-Accounts bleiben müssen
  region            String   @default("DE") // DE | EU
  languages         String[] @default(["de"])
  // Domains, die das Tracking-Snippet / die Agent-API nutzen dürfen (CORS)
  allowedOrigins    String[] @default([])
  // Öffentliche Agent-Schnittstelle (/api/agent/<slug>) für KI-Assistenten
  agentApiEnabled   Boolean  @default(true)
  // Vier-Augen-Prinzip: Antragsteller darf eigene Freigaben nicht selbst erteilen
  fourEyes          Boolean  @default(false)
  // Anreicherung von Personen (nur beruflich) – Standard aus; Info-Pflicht Art. 14 DSGVO beachten
  enrichPersons     Boolean  @default(false)
  // Presse-/Erwähnungs-Recherche für Unternehmen im Sub-Account
  mentionMonitoring Boolean  @default(false)

  // Firmendaten (Impressum, Rechnungen)
  legalName     String?
  legalAddress  String?
  legalPhone    String?
  legalEmail    String?
  vatId         String?
  iban          String?
  bic           String?
  // SEPA-Gläubiger-Identifikationsnummer (Bundesbank)
  creditorId    String?
  imprint       String? // Markdown, erscheint im Fuß von Landingpages und E-Mails
  // Standardtexte je Dokumentart: { QUOTE|ORDER|INVOICE: { intro, outro, paymentTerms, emailSubject, emailBody } }
  documentTexts Json    @default("{}")
  // Teamkalender des Sub-Accounts: { provider: google|microsoft, calendarId, connectionId (Verbindung eines Admins) }
  teamCalendar  Json?
  // CI/Markenleitfaden: { voice, doAndDont, colors[{name,hex,role}], typography, logoRules, sources[] }
  brandGuide    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts            Contact[]
  activities          Activity[]
  pipelines           Pipeline[]
  deals               Deal[]
  tasks               Task[]
  events              Event[]
  forms               Form[]
  campaigns           Campaign[]
  emails              EmailMessage[]
  sources             KnowledgeSource[]
  chunks              KnowledgeChunk[]
  wikiPages           WikiPage[]
  channels            ChannelAccount[]
  memberships         Membership[]
  pages               LandingPage[]
  analytics           AnalyticsEvent[]
  automations         Automation[]
  compliance          ComplianceItem[]
  invoices            Invoice[]
  aiLogs              AiUsageLog[]
  apiKeys             ApiKey[]
  emailTemplates      EmailTemplate[]
  emailEvents         EmailEvent[]
  suppressions        Suppression[]
  webhooks            Webhook[]
  contactLists        ContactList[]
  propertyDefinitions PropertyDefinition[]
  usageSnapshots      UsageSnapshot[]
  companies           Company[]
  lifecycleStages     LifecycleStage[]
  tickets             Ticket[]
  processes           Process[]
  processRuns         ProcessRun[]
  crmEvents           CrmEvent[]
  approvals           Approval[]
  auditLogs           AuditLog[]
  roles               Role[]
  teams               Team[]
  invitations         Invitation[]
  suggestions         EnrichmentSuggestion[]
  mentions            Mention[]
  files               StoredFile[]
  channelPosts        ChannelPost[]
  meetingTypes        MeetingType[]
  domains             Domain[]
  inboxes             Inbox[]
  conversations       Conversation[]
  messages            Message[]
  products            Product[]
  subscriptions       Subscription[]
  mandates            SepaMandate[]
  debitBatches        DirectDebitBatch[]
  paymentProviders    PaymentProvider[]
  payments            Payment[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
}

// ---------- Kontakte ----------

model Contact {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  firstName         String?
  lastName          String?
  // berufliche Funktion (Anreicherung nur beruflich, siehe ADR-016)
  jobTitle          String?
  // öffentliche berufliche Profil-Links, z. B. { linkedin: "https://…" } – nur Links, keine kopierten Inhalte
  socialLinks       Json      @default("{}")
  enrichedAt        DateTime?
  email             String?
  phone             String?
  company           String?
  source            String?
  tags              String[]  @default([])
  // E-Mail-Einwilligung (Double-Opt-in-Nachweis). Ohne consentEmailAt kein Newsletter.
  consentEmailAt    DateTime?
  consentSource     String?
  unsubscribedAt    DateTime?
  // Einwilligungen für Kanäle (Werbung per SMS/WhatsApp nur mit ausdrücklicher Einwilligung, § 7 UWG)
  smsConsentAt      DateTime?
  whatsappConsentAt DateTime?
  whatsappOptOutAt  DateTime?
  // Echtheit des Leads 0–100 (höher = vertrauenswürdiger) + Signale
  trustScore        Int?
  trustSignals      Json?
  // Eigene Felder (Schlüssel aus PropertyDefinition), Brevo-/HubSpot-kompatibel
  attributes        Json      @default("{}")
  // Verknüpftes Unternehmen (Objekt); `company` bleibt als Freitext für Altdaten/Importe
  companyId         String?
  companyRecord     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Lifecycle-Phase (Schlüssel aus LifecycleStage), z. B. lead, mql, sql, customer
  lifecycleStage    String    @default("lead")
  ownerId           String?
  owner             User?     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Herkunft bei Import, z. B. "hubspot:123"
  externalRef       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities      Activity[]
  deals           Deal[]
  tasks           Task[]
  events          Event[]
  emails          EmailMessage[]
  recipients      CampaignRecipient[]
  invoices        Invoice[]
  listMemberships ContactListMember[]
  tickets         Ticket[]
  mentions        Mention[]
  conversations   Conversation[]
  subscriptions   Subscription[]
  mandates        SepaMandate[]

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, lifecycleStage])
  @@index([companyId])
}

enum ActivityType {
  NOTE
  EMAIL_OUT
  EMAIL_IN
  FORM
  DEAL
  TASK
  SYSTEM
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        ActivityType
  body        String
  meta        Json?
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([contactId, createdAt])
}

// ---------- Pipeline ----------

enum StageKind {
  OPEN
  WON
  LOST
  CLOSED // Tickets: erledigt
}

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // deal | ticket
  objectType  String    @default("deal")
  externalRef String?
  stages      Stage[]
  deals       Deal[]
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
}

model Stage {
  id          String    @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  kind        StageKind @default(OPEN)
  externalRef String?
  deals       Deal[]
  tickets     Ticket[]

  @@index([pipelineId, position])
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title       String
  valueCents  Int       @default(0)
  currency    String    @default("EUR")
  position    Int       @default(0)
  lostReason  String?
  closedAt    DateTime?
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  externalRef String?
  attributes  Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([workspaceId, stageId, position])
}

// ---------- Aufgaben & Kalender ----------

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  dueAt       DateTime?
  doneAt      DateTime?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, doneAt, dueAt])
  @@index([ownerId, doneAt])
}

model Event {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title            String
  startsAt         DateTime
  endsAt           DateTime
  location         String?
  description      String?
  // Organisator (Mitarbeiter, in dessen Kalender der Termin liegt)
  ownerId          String?
  owner            User?        @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // none | google_meet | ms_teams | jitsi | opentalk | phone | onsite
  videoProvider    String       @default("none")
  joinUrl          String?
  // Teilnehmende: [{ email, name, contactId?, response }]
  attendees        Json         @default("[]")
  meetingTypeId    String?
  meetingType      MeetingType? @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)
  // IDs in externen Kalendern: { google: { calendarId, eventId }, microsoft: {…}, team: {…} }
  externalRefs     Json         @default("{}")
  // scheduled | cancelled
  status           String       @default("scheduled")
  icsUid           String?      @unique
  icsSequence      Int          @default(0)
  // Öffentliche Buchung: Verwaltungslink (Umbuchen/Absagen) über signiertes Token; Hash hier
  bookingTokenHash String?      @unique
  // booking | crm | process | mcp
  source           String       @default("crm")
  updatedAt        DateTime     @default(now()) @updatedAt
  contactId        String?
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@index([workspaceId, startsAt])
}

// ---------- Formulare ----------

model Form {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // [{ key, label, type: "text"|"email"|"tel"|"textarea"|"checkbox", required }]
  fields      Json
  // Wenn gesetzt: Checkbox-Feld, das als E-Mail-Einwilligung zählt
  consentText String?
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contactId String?
  data      Json
  createdAt DateTime @default(now())
}

// ---------- E-Mail ----------

enum CampaignStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  FAILED
}

model Campaign {
  id           String              @id @default(cuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  subject      String
  bodyMarkdown String
  // Zielgruppe: { tags?: string[] } – nur Kontakte mit Einwilligung, nicht abgemeldet
  audience     Json                @default("{}")
  status       CampaignStatus      @default(DRAFT)
  // Freigabe-Prinzip: Versand erst nach ausdrücklicher Freigabe durch einen Menschen
  approvedAt   DateTime?
  approvedBy   String?
  sentAt       DateTime?
  recipients   CampaignRecipient[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String    @default("queued") // queued | sent | failed | skipped
  error      String?
  messageId  String?
  sentAt     DateTime?

  @@unique([campaignId, contactId])
}

enum MailDirection {
  OUT
  IN
}

model EmailMessage {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaignId  String?
  direction   MailDirection
  fromAddr    String
  toAddr      String
  subject     String
  bodyText    String
  messageId   String?
  // queued | captured | sent | delivered | soft_bounce | hard_bounce | blocked | spam | failed
  status      String        @default("sent")
  // one_to_one | campaign | transactional | system
  kind        String        @default("one_to_one")
  htmlBody    String?
  templateId  String?
  tags        String[]      @default([])
  apiKeyId    String?
  error       String?
  scheduledAt DateTime?
  sentAt      DateTime?
  events      EmailEvent[]
  createdAt   DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([messageId])
}

// ---------- Wissen (RAG im CRM) ----------

model KnowledgeSource {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String // text | url | file
  title       String
  uri         String?
  status      String           @default("pending") // pending | indexed | failed
  error       String?
  contentHash String?
  // Originaltext (bei kind "text"), damit neu indiziert werden kann
  content     String?
  // Darf über die öffentliche Agent-Schnittstelle zitiert werden
  isPublic    Boolean          @default(false)
  chunks      KnowledgeChunk[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model KnowledgeChunk {
  id          String                       @id @default(cuid())
  workspaceId String
  workspace   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    String
  source      KnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  position    Int
  content     String
  // Dimension muss zu EMBED_DIM passen (qwen3-embedding:0.6b = 1024)
  embedding   Unsupported("vector(1024)")?
  embedModel  String
  createdAt   DateTime                     @default(now())

  @@index([workspaceId])
}

// ---------- Wiki (vom LLM gepflegt, vom Menschen freigegeben) ----------

model WikiPage {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  body        String
  revisions   WikiRevision[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([workspaceId, slug])
}

model WikiRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  body      String
  author    String // "mensch" | "llm:<modell>"
  // LLM-Vorschläge sind "proposed" bis ein Mensch sie freigibt
  status    String   @default("applied") // proposed | applied | rejected
  note      String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

// ---------- Kanäle für die Übersicht (YouTube, Social, Newsletter) ----------

model ChannelAccount {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform       String // youtube | linkedin | instagram | x | facebook | website
  handle         String
  externalId     String?
  url            String?
  // manual | api | import
  connection     String          @default("manual")
  // verschlüsselte Zugangsdaten (OAuth-Token o. ä.), nie im Klartext
  credentials    String?
  tokenExpiresAt DateTime?
  lastSyncAt     DateTime?
  lastError      String?
  metrics        ChannelMetric[]
  createdAt      DateTime        @default(now())
  posts          ChannelPost[]

  @@unique([workspaceId, platform, handle])
}

model ChannelMetric {
  id        String         @id @default(cuid())
  accountId String
  account   ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  followers Int?
  views     Int?
  posts     Int?
  extra     Json?

  @@unique([accountId, date])
}

// ---------- Anmeldung & Rollen ----------

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String
  passwordHash          String
  isAgencyAdmin         Boolean              @default(false)
  // owner | admin | member – Inhaber/Admin sehen alle Sub-Accounts; isAgencyAdmin bleibt abgeleitet
  agencyRole            String               @default("member")
  // false = Einladung noch nicht angenommen
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  memberships           Membership[]
  sessions              Session[]
  ownedContacts         Contact[]            @relation("ContactOwner")
  ownedDeals            Deal[]               @relation("DealOwner")
  ownedCompanies        Company[]            @relation("CompanyOwner")
  ownedTickets          Ticket[]             @relation("TicketOwner")
  ownedTasks            Task[]               @relation("TaskOwner")
  teamMemberships       TeamMember[]
  oauthCodes            OAuthCode[]
  oauthTokens           OAuthToken[]
  ownedEvents           Event[]              @relation("EventOwner")
  calendarConnections   CalendarConnection[]
  assignedConversations Conversation[]       @relation("ConversationAssignee")
}

enum MemberRole {
  ADMIN
  MEMBER
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // veraltet (Welle 1): bleibt bis zur Umstellung aller Prüfungen auf roleId
  role        MemberRole @default(MEMBER)
  roleId      String?
  roleRef     Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 des Cookie-Tokens; das Token selbst wird nie gespeichert
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Landingpages ----------

enum PageStatus {
  DRAFT
  PUBLISHED
}

model LandingPage {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug           String
  lang           String     @default("de")
  // gleiche groupId = Sprachfassungen derselben Seite
  groupId        String     @default(cuid())
  title          String
  seoTitle       String?
  seoDescription String?
  // Puck-Daten (Entwurf) und veröffentlichte Fassung getrennt
  data           Json
  publishedData  Json?
  status         PageStatus @default(DRAFT)
  publishedAt    DateTime?
  publishedBy    String?
  // Barrierefreiheits-Prüfung der letzten Veröffentlichung
  a11yReport     Json?
  // true, wenn Inhalte (teilweise) von KI erzeugt wurden (AI-Act-Transparenz)
  aiGenerated    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([workspaceId, slug, lang])
}

// ---------- Analytics (cookiefrei, ohne IP-Speicherung) ----------

model AnalyticsEvent {
  id           BigInt    @id @default(autoincrement())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ts           DateTime  @default(now())
  date         DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  kind         String // pageview | event | bot | conversion
  name         String? // Ereignisname bei kind=event/conversion
  host         String? // Domain, auf der das Ereignis passierte
  path         String
  pageId       String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  device       String? // desktop | mobile | tablet | bot
  lang         String?
  // Tagesrotierender Hash mit geheimem Salz → nicht über Tage verknüpfbar
  visitorHash  String?
  // Bots: search | ai_training | ai_search | ai_user | seo | other
  botCategory  String?
  botName      String?
  // Menschen, die aus einer KI-Antwort kommen: chatgpt | perplexity | claude | gemini | copilot | …
  aiReferrer   String?
  contactId    String?
  valueCents   Int?

  @@index([workspaceId, date])
  @@index([workspaceId, kind, date])
  @@index([workspaceId, botCategory, date])
  @@index([workspaceId, name])
  @@index([workspaceId, kind, contactId])
}

model AnalyticsSalt {
  date DateTime @id @db.Date
  salt String
}

// ---------- Automationen & Jobs ----------

model Automation {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  // FORM_SUBMITTED | TAG_ADDED | DEAL_STAGE_CHANGED | AGENT_REQUEST | CONSENT_CONFIRMED
  trigger       String
  triggerConfig Json            @default("{}")
  // [{ type: "email"|"task"|"tag"|"notify"|"wait", ... }]
  actions       Json            @default("[]")
  enabled       Boolean         @default(false)
  // Freigabe-Prinzip: Automationen mit Außenwirkung brauchen eine Freigabe
  approvedAt    DateTime?
  approvedBy    String?
  runs          AutomationRun[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId    String?
  status       String     @default("running") // running | done | failed
  log          Json       @default("[]")
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
}

model Job {
  id         String    @id @default(cuid())
  type       String
  payload    Json
  status     String    @default("queued") // queued | running | done | failed
  runAt      DateTime  @default(now())
  attempts   Int       @default(0)
  lastError  String?
  lockedAt   DateTime?
  // Laufzeit des letzten Versuchs (für das Kosten-Cockpit)
  startedAt  DateTime?
  durationMs Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAt])
}

// ---------- Pflichten (Compliance) ----------

model ComplianceItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // BFSG | AI_ACT | CRA | NIS2 | E_RECHNUNG | MAIL_AUTH | DSGVO | SOUVERAENITAET
  framework   String
  key         String
  title       String
  description String?
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | N_A
  evidence    String?
  // automatisch geprüft (z. B. DNS) → letztes Ergebnis
  autoResult  Json?
  dueAt       DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, framework, key])
}

// KI-Nutzung protokollieren (Transparenz nach AI Act, Kostenkontrolle)
model AiUsageLog {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purpose     String // z. B. rag-answer, wiki-proposal, page-draft, translation
  provider    String     @default("ollama")
  model       String
  ms          Int?
  tokensIn    Int?
  tokensOut   Int?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
}

// ---------- Angebote & Rechnungen ----------

model Invoice {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  kind               String    @default("INVOICE") // QUOTE | INVOICE
  number             String
  status             String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | PAID | CANCELLED
  issueDate          DateTime  @default(now()) @db.Date
  dueDate            DateTime? @db.Date
  currency           String    @default("EUR")
  // [{ title, qty, unitCents, vatRate }]
  items              Json      @default("[]")
  netCents           Int       @default(0)
  vatCents           Int       @default(0)
  grossCents         Int       @default(0)
  // Leitweg-ID bzw. Käuferreferenz (Pflichtfeld XRechnung)
  buyerReference     String?
  buyerName          String?
  buyerAddress       String?
  buyerEmail         String?
  // Leistungszeitraum (XRechnung BT-73/74); leer = Leistungsdatum gleich Rechnungsdatum
  serviceFrom        DateTime? @db.Date
  serviceTo          DateTime? @db.Date
  // Grund der Steuerbefreiung bei 0 % (XRechnung BT-120)
  taxExemptionReason String?
  notes              String?
  // Einleitungs-/Schlusstext je Dokument (Platzhalter erlaubt); leer = Standardtext des Sub-Accounts
  introText          String?
  outroText          String?
  // Herkunft bei Auftragsbestätigung (kind ORDER): angenommenes Angebot
  fromOrderId        String?
  // Kundenseitige Bestellnummer/Referenz (auf AB und Rechnung)
  customerOrderRef   String?
  subscriptionId     String?
  // Mahnstufe 0 = keine; 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung
  dunningLevel       Int       @default(0)
  dunnedAt           DateTime?
  // sepa | transfer
  paymentMethod      String    @default("transfer")
  fromQuoteId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, kind, number])
}

// ---------- API-Schlüssel (pro Sub-Account) ----------

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // sichtbarer Anfang des Schlüssels zur Wiedererkennung, z. B. "pdk_a1b2c3"
  prefix      String    @unique
  // SHA-256 des vollständigen Schlüssels; der Schlüssel selbst wird nur einmal angezeigt
  hash        String    @unique
  // mail:send | contacts:read | contacts:write | templates:read | webhooks:manage
  scopes      String[]  @default([])
  createdBy   String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- E-Mail-Vorlagen, Ereignisse, Sperrliste, Webhooks ----------

model EmailTemplate {
  id          String    @id @default(cuid())
  // Numerische ID wie bei Brevo (templateId), damit bestehende Integrationen weiterlaufen
  numericId   Int       @unique @default(autoincrement())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  // Platzhalter im Brevo-Stil: {{ params.name }}, {{ contact.FIRSTNAME }}
  html        String
  text        String?
  senderName  String?
  senderEmail String?
  replyTo     String?
  // optional: Puck-Daten, falls im visuellen Editor gebaut
  design      Json?
  isActive    Boolean   @default(true)
  // Herkunft bei Import, z. B. "brevo:12"
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmailEvent {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId   String
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // request | delivered | deferred | soft_bounce | hard_bounce | blocked | spam | invalid | opened | click | unsubscribed | error
  event       String
  reason      String?
  link        String?
  at          DateTime     @default(now())

  @@index([workspaceId, at])
  @@index([messageId])
}

model Suppression {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  // hard_bounce | spam | unsubscribed | manual | import
  reason      String
  source      String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
}

model Webhook {
  id          String    @id @default(cuid())
  numericId   Int       @unique @default(autoincrement())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  description String?
  // transactional | marketing | crm
  type        String    @default("transactional")
  events      String[]  @default([])
  // optionales Geheimnis → HMAC-Signatur im Header X-PD-Signature
  secret      String?
  active      Boolean   @default(true)
  lastStatus  Int?
  lastError   String?
  lastAt      DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Listen & eigene Felder (Brevo/HubSpot-kompatibel) ----------

model ContactList {
  id          String              @id @default(cuid())
  numericId   Int                 @unique @default(autoincrement())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // static = feste Mitglieder; dynamic = Filter (später)
  kind        String              @default("static")
  filter      Json?
  source      String?
  members     ContactListMember[]
  createdAt   DateTime            @default(now())

  @@unique([workspaceId, name])
}

model ContactListMember {
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@id([listId, contactId])
  @@index([contactId])
}

model PropertyDefinition {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // contact | company | deal
  objectType  String    @default("contact")
  // Schlüssel in GROSSBUCHSTABEN wie bei Brevo (FIRSTNAME) oder snake_case (HubSpot) – frei wählbar
  key         String
  label       String
  // text | number | date | boolean | select
  type        String    @default("text")
  options     Json?
  source      String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, objectType, key])
}

// ---------- Nutzung & Kosten ----------

model UsageSnapshot {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  // Zählwerte (Zeilen, Bytes, Mails, KI-Aufrufe, Tokens …)
  metrics      Json
  // geschätzte Monatskosten auf Basis der Kostensätze
  estCostCents Int
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, date])
}

// Einstellungen auf Agentur-Ebene (z. B. Kostensätze)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- HubSpot-Bausteine: Unternehmen, Lifecycle, Tickets ----------

model Company {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  // Primäre Domain (ohne www), für automatische Zuordnung von Kontakten per E-Mail-Domain
  domain            String?
  industry          String?
  size              String?
  phone             String?
  address           String?
  website           String?
  // { linkedin, xing, instagram, facebook, youtube, x, … } – von der Firmen-Website verlinkt
  socialLinks       Json      @default("{}")
  // Impressum: Registergericht/-nummer, USt-ID, Geschäftsführung (übernommen nach Prüfung)
  registerCourt     String?
  registerNumber    String?
  vatId             String?
  managingDirectors String[]  @default([])
  // KI-Profil (Branche, Angebot, Zielgruppe, Größe-Indiz, Zusammenfassung) mit Quellen
  profile           Json?
  enrichedAt        DateTime?
  lifecycleStage    String?
  ownerId           String?
  owner             User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  attributes        Json      @default("{}")
  externalRef       String?
  contacts          Contact[]
  deals             Deal[]
  tickets           Ticket[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  mentions          Mention[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
}

model LifecycleStage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int

  @@unique([workspaceId, key])
}

model Ticket {
  id              String    @id @default(cuid())
  numericId       Int       @unique @default(autoincrement())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId      String
  pipeline        Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId         String
  stage           Stage     @relation(fields: [stageId], references: [id])
  subject         String
  description     String?
  // low | medium | high | urgent
  priority        String    @default("medium")
  // email | form | agent | phone | chat | manual | api | import
  source          String    @default("manual")
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?     @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  closedAt        DateTime?
  attributes      Json      @default("{}")
  externalRef     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, stageId])
  @@index([workspaceId, createdAt])
}

// ---------- Prozesse (Workflow-Engine) ----------

enum ProcessStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Process {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // contact | company | deal | ticket
  objectType      String
  status          ProcessStatus    @default(DRAFT)
  // Best-Practice-Vorlage, aus der der Prozess entstand (z. B. "lead-eingang")
  templateKey     String?
  activeVersionId String?
  versions        ProcessVersion[]
  runs            ProcessRun[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId, status])
}

model ProcessVersion {
  id          String       @id @default(cuid())
  processId   String
  process     Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  version     Int
  // ProcessDefinition (src/lib/process/definition.ts); nach Veröffentlichung unveränderlich
  definition  Json
  validation  Json?
  // true, wenn die Definition Aktionen mit Außenwirkung enthält (E-Mail, Webhook)
  external    Boolean      @default(false)
  createdBy   String?
  createdAt   DateTime     @default(now())
  publishedAt DateTime?
  publishedBy String?
  // Freigabe für Aktionen mit Außenwirkung
  approvedAt  DateTime?
  approvedBy  String?
  runs        ProcessRun[]

  @@unique([processId, version])
}

model ProcessRun {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  processId      String
  process        Process          @relation(fields: [processId], references: [id], onDelete: Cascade)
  versionId      String
  version        ProcessVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  objectType     String
  objectId       String
  // running | waiting | done | goal_met | failed | cancelled
  status         String           @default("running")
  currentNodeId  String?
  // Zwischenergebnisse der Schritte (z. B. KI-Klassifikation)
  context        Json             @default("{}")
  triggerEventId String?
  // verhindert doppelte Einschreibung für dasselbe Ereignis
  dedupeKey      String           @unique
  test           Boolean          @default(false)
  error          String?
  startedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  finishedAt     DateTime?
  steps          ProcessStepLog[]

  @@index([processId, startedAt])
  @@index([workspaceId, objectType, objectId])
}

model ProcessStepLog {
  id        String     @id @default(cuid())
  runId     String
  run       ProcessRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String
  nodeType  String
  // ok | skipped | failed | waiting | branch
  status    String
  detail    Json?
  ms        Int?
  createdAt DateTime   @default(now())

  @@unique([runId, nodeId, createdAt])
  @@index([runId, createdAt])
}

// Transaktionale Outbox: jede fachliche Änderung erzeugt ein Ereignis; der Worker verteilt es an Prozesse
model CrmEvent {
  id          BigInt    @id @default(autoincrement())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // z. B. contact.created, deal.stage_changed (siehe src/lib/events.ts)
  type        String
  objectType  String
  objectId    String
  data        Json      @default("{}")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?

  @@index([processedAt, id])
  @@index([workspaceId, type, createdAt])
}

// Freigabe-Eingang: Aktionen mit Außenwirkung (von MCP, Prozessen, KI) warten hier auf einen Menschen
model Approval {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // z. B. process.publish, mail.send, campaign.send, contact.delete
  kind        String
  title       String
  summary     String?
  payload     Json
  // pending | approved | rejected | expired | failed
  status      String    @default("pending")
  requestedBy String
  decidedBy   String?
  decidedAt   DateTime?
  result      Json?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, status, createdAt])
}

// Wer hat was getan (Benutzer, API-Schlüssel, MCP, Prozess)
model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // user:<id> | apikey:<id> | mcp:<keyId> | process:<runId> | system
  actor       String
  action      String
  target      String?
  detail      Json?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
}

// Fenster-Zähler für Rate-Limits (mehrinstanzfähig). Einträge laufen ab und werden regelmäßig gelöscht.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ---------- Rollen, Teams, Einladungen ----------

// Rolle je Sub-Account: entsteht aus einer Vorlage (presetKey) und ist anpassbar.
model Role {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // admin | teamleitung | vertrieb | service | marketing | buchhaltung | nurlesen | eigene Schlüssel
  key         String
  name        String
  description String?
  // Vorlage, aus der die Rolle stammt (null = frei angelegt)
  presetKey   String?
  // { objects: { contacts: { read: "all", edit: "own", delete: "none" }, … }, special: { export: true, … } }
  permissions Json
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, key])
}

model Team {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  members     TeamMember[]
  createdAt   DateTime     @default(now())

  @@unique([workspaceId, name])
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid())
  email       String
  // Sub-Account-Einladung (mit Rolle) oder Agentur-Einladung (workspaceId null, agencyRole gesetzt)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roleKey     String?
  agencyRole  String?
  tokenHash   String     @unique
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([email])
}

// ---------- OAuth 2.1 (für MCP-Konnektoren externer LLMs) ----------

model OAuthClient {
  id           String       @id @default(cuid())
  clientId     String       @unique
  // nur bei vertraulichen Clients; öffentliche Clients nutzen PKCE ohne Geheimnis
  secretHash   String?
  name         String
  redirectUris String[]
  // dynamische Registrierung (RFC 7591) oder manuell angelegt
  registeredBy String       @default("dynamic")
  metadata     Json?
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  tokens       OAuthToken[]
}

model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  scopes        String[]
  redirectUri   String
  codeChallenge String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

model OAuthToken {
  id               String      @id @default(cuid())
  accessHash       String      @unique
  refreshHash      String?     @unique
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String
  scopes           String[]
  resource         String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  // Token-Familie (= ID des Autorisierungscodes): Wiederverwendung eines rotierten Refresh-Tokens widerruft die ganze Familie
  familyId         String?
  // gesetzt, wenn das Refresh-Token durch Rotation abgelöst wurde
  rotatedAt        DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@index([familyId])
}

// ---------- Anreicherung & Recherche ----------

// Vorschlag für ein Feld aus öffentlicher Quelle – wird erst nach menschlicher Prüfung übernommen
model EnrichmentSuggestion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // contact | company
  objectType  String
  objectId    String
  // Zielfeld, z. B. legalAddress, phone, vatId, registerNumber, managingDirectors, socialLinks.linkedin, jobTitle, profile
  field       String
  value       Json
  // Quelle (URL) und Art: website | impressum | searxng | gdelt | ai
  sourceUrl   String?
  sourceKind  String
  confidence  Float?
  // proposed | accepted | rejected | superseded
  status      String    @default("proposed")
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, objectType, objectId, status])
}

// Presse-/Web-Erwähnung eines Unternehmens oder Kontakts
model Mention {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  url         String
  title       String
  // Domain der Quelle, z. B. handelsblatt.com
  sourceHost  String?
  // gdelt | searxng | website | rss
  sourceKind  String
  language    String?
  publishedAt DateTime?
  snippet     String?
  // KI-Auswertung (lokal/EU): Kurzfassung, Tonalität, Relevanz 0–1, Themen
  summary     String?
  sentiment   String? // positiv | neutral | negativ
  relevance   Float?
  topics      String[]  @default([])
  // new | relevant | irrelevant
  status      String    @default("new")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, url, companyId])
  @@index([workspaceId, companyId, publishedAt])
  @@index([workspaceId, contactId, publishedAt])
}

// Beitrag/Video eines Kanals mit Kennzahlen (lesend aus Plattform-API oder Import)
model ChannelPost {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  url         String?
  title       String?
  publishedAt DateTime?
  // { impressions, views, likes, comments, shares, clicks, engagementRate }
  metrics     Json           @default("{}")
  fetchedAt   DateTime       @default(now())

  @@unique([accountId, externalId])
  @@index([workspaceId, publishedAt])
}

// Hochgeladene Dateien (z. B. CI-/Brandbook). Inhalt im Dateispeicher (lokal bzw. S3/STACKIT), hier nur Metadaten.
model StoredFile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // brandbook | logo | document | other
  kind        String
  name        String
  mime        String
  size        Int
  sha256      String
  storageKey  String    @unique
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, kind])
}

// ---------- Kalender & Video-Calls ----------

// Terminvorlage je Sub-Account (einheitliche Einladungen)
model MeetingType {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  // Titel/Beschreibung mit Platzhaltern ({{ contact.FIRSTNAME }}, {{ company.name }}, {{ owner.name }} …)
  titleTemplate     String
  description       String?
  durationMin       Int       @default(30)
  bufferMin         Int       @default(0)
  // google_meet | ms_teams | jitsi | opentalk | phone | onsite
  videoProvider     String    @default("google_meet")
  location          String?
  // Erinnerungen in Minuten vor Beginn
  reminders         Int[]     @default([1440, 15])
  // zusätzlich in den Teamkalender des Sub-Accounts eintragen
  addToTeamCalendar Boolean   @default(true)
  active            Boolean   @default(true)
  // Öffentliche Buchung
  bookingEnabled    Boolean   @default(false)
  bookingSlug       String?
  // Wochenzeiten: { mo: [["09:00","12:00"],["13:00","17:00"]], di: …, zeitzone: "Europe/Berlin" }
  availability      Json      @default("{}")
  minNoticeHours    Int       @default(12)
  maxDaysAhead      Int       @default(30)
  slotIntervalMin   Int       @default(30)
  // Gastgeber (Rundlauf); leer = Ersteller/Agentur
  hostUserIds       String[]  @default([])
  // Zusatzfragen: [{ key, label, type, required }]
  questions         Json      @default("[]")
  confirmationText  String?
  events            Event[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@unique([workspaceId, bookingSlug])
}

// Kalender-Verbindung eines Benutzers (OAuth, Tokens verschlüsselt)
model CalendarConnection {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // google | microsoft
  provider       String
  accountEmail   String
  credentials    String // verschlüsselt (secretbox)
  scopes         String[]
  tokenExpiresAt DateTime?
  // primärer Kalender des Benutzers
  calendarId     String    @default("primary")
  status         String    @default("active") // active | reconnect | revoked
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider, accountEmail])
}

// ---------- Eigene Domains (Landingpages, Mail) ----------

model Domain {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostname            String    @unique
  // landing | mail
  purpose             String    @default("landing")
  // erkannter DNS-Anbieter (aus NS-Einträgen), z. B. ionos, godaddy, cloudflare, hetzner, inwx, strato, unknown
  dnsProvider         String?
  // api | domain_connect | manual
  method              String    @default("manual")
  // Soll-Einträge: [{ type, name, value, ttl, purpose }]
  records             Json      @default("[]")
  // Besitznachweis per TXT
  verifyToken         String
  // pending_dns | verifying | active | error | removed
  status              String    @default("pending_dns")
  // letzter Prüfbericht: je Eintrag ok/fehlt/falsch, Resolver-Ergebnisse, Zertifikat
  checkReport         Json?
  certExpiresAt       DateTime?
  lastCheckAt         DateTime?
  verifiedAt          DateTime?
  // verschlüsselte API-Zugangsdaten des Kunden beim DNS-Anbieter (nur falls Methode api gewählt)
  providerCredentials String?
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId, purpose])
}

// ---------- Gemeinsamer Posteingang (E-Mail, WhatsApp, SMS, später Web-Chat) ----------

model Inbox {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  // email | whatsapp | sms | webchat
  kind          String
  // Adresse bzw. Rufnummer (E.164) des Kanals
  address       String
  // Anbieter/Transport: imap | gmail | microsoft | whatsapp_cloud | <bsp> | sipgate | seven | …
  provider      String
  // nicht geheime Einstellungen (Server, Ordner, Signatur, Zuweisungsmodus round_robin|manual)
  config        Json           @default("{}")
  // verschlüsselte Zugangsdaten (secretbox)
  credentials   String?
  active        Boolean        @default(true)
  status        String         @default("ok") // ok | error | reconnect
  lastSyncAt    DateTime?
  lastError     String?
  conversations Conversation[]
  createdAt     DateTime       @default(now())

  @@unique([workspaceId, kind, address])
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxId       String
  inbox         Inbox     @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  subject       String?
  // open | pending | snoozed | closed
  status        String    @default("open")
  snoozedUntil  DateTime?
  assigneeId    String?
  assignee      User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority      String    @default("normal")
  tags          String[]  @default([])
  ticketId      String?
  // Schlüssel zur Zuordnung eingehender Nachrichten (E-Mail-Thread-Wurzel, Rufnummer, …)
  threadKey     String
  lastMessageAt DateTime  @default(now())
  unread        Int       @default(0)
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([inboxId, threadKey])
  @@index([workspaceId, status, lastMessageAt])
  @@index([assigneeId, status])
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // in | out | note (interne Notiz)
  direction      String
  channel        String
  fromAddr       String?
  toAddrs        String[]     @default([])
  ccAddrs        String[]     @default([])
  subject        String?
  bodyText       String
  // nur bereinigt anzeigen; nie ungefiltert rendern
  bodyHtml       String?
  // Message-ID bzw. Anbieter-ID – eindeutig je Kanal (Dubletten beim Abruf vermeiden)
  externalId     String?
  inReplyTo      String?
  references     String[]     @default([])
  // received | queued | sent | delivered | read | failed
  status         String       @default("received")
  error          String?
  sentById       String?
  // [{ fileId, name, mime, size }]
  attachments    Json         @default("[]")
  createdAt      DateTime     @default(now())

  @@unique([conversationId, externalId])
  @@index([workspaceId, createdAt])
}

// ---------- Abos & SEPA-Lastschrift ----------

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  unitCents   Int
  vatRate     Int       @default(19)
  // one_time | monthly | quarterly | yearly
  interval    String    @default("monthly")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscription {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  companyId        String?
  // active | paused | cancelled | ended
  status           String       @default("active")
  // [{ productId?, title, qty, unitCents, vatRate }]
  items            Json         @default("[]")
  interval         String       @default("monthly")
  startDate        DateTime     @db.Date
  nextBillingDate  DateTime     @db.Date
  minTermMonths    Int          @default(0)
  noticePeriodDays Int          @default(30)
  cancelledAt      DateTime?
  endDate          DateTime?    @db.Date
  // sepa | transfer
  paymentMethod    String       @default("transfer")
  mandateId        String?
  mandate          SepaMandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  // B2C: online geschlossen → Kündigungsbutton (§ 312k BGB)
  consumer         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId, status, nextBillingDate])
}

model SepaMandate {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Restrict)
  mandateRef    String
  accountHolder String
  // IBAN verschlüsselt (secretbox); Anzeige nur letzte 4 Stellen
  ibanEncrypted String
  ibanLast4     String
  bic           String?
  // CORE (Basis) | B1 (Firmen)
  scheme        String            @default("CORE")
  signedAt      DateTime          @db.Date
  // FRST bis zur ersten Einreichung, danach RCUR
  sequence      String            @default("FRST")
  status        String            @default("active") // active | revoked | expired
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  // Nachweis (unterschriebenes Mandat) im Dateispeicher
  proofFileId   String?
  subscriptions Subscription[]
  debitItems    DirectDebitItem[]
  createdAt     DateTime          @default(now())

  @@unique([workspaceId, mandateRef])
}

model DirectDebitBatch {
  id             String            @id @default(cuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collectionDate DateTime          @db.Date
  // draft | exported | submitted | settled
  status         String            @default("draft")
  totalCents     Int               @default(0)
  count          Int               @default(0)
  messageId      String            @unique
  fileId         String?
  createdBy      String?
  items          DirectDebitItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model DirectDebitItem {
  id           String           @id @default(cuid())
  batchId      String
  batch        DirectDebitBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invoiceId    String
  mandateId    String
  mandate      SepaMandate      @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  amountCents  Int
  sequence     String
  endToEndId   String
  // pending | collected | returned
  status       String           @default("pending")
  returnReason String?

  @@unique([batchId, invoiceId])
}

// ---------- Zahlungen (Bezahllinks/Online-Zahlung) & Kontoabgleich ----------

// Zahlungsanbieter je Sub-Account: mollie (Wero, SEPA, Karte, …) | revolut | unzer
model PaymentProvider {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  // test | live
  mode        String    @default("test")
  // verschlüsselte Zugangsdaten (API-Key, Webhook-Secret)
  credentials String
  // freigeschaltete Zahlarten, z. B. ["wero","creditcard","sepadirectdebit","revolut_pay"]
  methods     String[]  @default([])
  active      Boolean   @default(true)
  // Standard-Anbieter für Bezahllinks auf Rechnungen
  isDefault   Boolean   @default(false)
  status      String    @default("ok")
  lastError   String?
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, provider])
}

model Payment {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerId     String
  providerRef    PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoiceId      String?
  subscriptionId String?
  // ID beim Anbieter (Mollie tr_…, Revolut Order-ID)
  externalId     String
  // gewählte/benutzte Zahlart beim Anbieter, z. B. wero, creditcard, revolut_pay
  method         String?
  amountCents    Int
  currency       String          @default("EUR")
  // open | pending | authorized | paid | failed | expired | canceled | refunded | partially_refunded
  status         String          @default("open")
  checkoutUrl    String?
  paidAt         DateTime?
  expiresAt      DateTime?
  refundedCents  Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([providerId, externalId])
  @@index([workspaceId, invoiceId])
}

// Bankkonto für den Abgleich: revolut_business (API) | camt (Kontoauszug-Import) | fints (später)
model BankAccount {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  source       String
  ibanLast4    String?
  currency     String            @default("EUR")
  credentials  String?
  lastSyncAt   DateTime?
  lastError    String?
  transactions BankTransaction[]
  createdAt    DateTime          @default(now())
}

model BankTransaction {
  id                    String      @id @default(cuid())
  workspaceId           String
  workspace             Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId             String
  account               BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Anbieter-ID bzw. Hash aus Kontoauszug – Dubletten vermeiden
  externalId            String
  bookingDate           DateTime    @db.Date
  amountCents           Int // positiv = Eingang, negativ = Ausgang
  currency              String      @default("EUR")
  counterparty          String?
  counterpartyIbanLast4 String?
  remittance            String?
  endToEndId            String?
  // unmatched | suggested | matched | ignored
  status                String      @default("unmatched")
  matchedInvoiceId      String?
  matchScore            Float?
  matchedBy             String?
  createdAt             DateTime    @default(now())

  @@unique([accountId, externalId])
  @@index([workspaceId, status, bookingDate])
}
